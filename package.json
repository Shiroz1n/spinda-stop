{
  "name": "spinda-stop",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/domain",
    "packages/data"
  ],
  "scripts": {
    "predev": "npm run sync --workspace @spinda-stop/data",
    "dev": "npm run dev --workspace @spinda-stop/web",
    "prebuild": "npm run sync --workspace @spinda-stop/data",
    "build": "npm run build --workspace @spinda-stop/web",
    "preview": "npm run preview --workspace @spinda-stop/web",
    "visual:review": "npm run build && node apps/web/test/visual-review.mjs",
    "visual:review:fast": "npm run build && node apps/web/test/visual-review.mjs --fast",
    "lint": "eslint .",
    "test": "node --test packages/domain/test/*.test.js packages/data/test/*.test.js apps/web/test/*.test.js apps/api/test/*.test.js",
    "validate:damage-oracle": "node scripts/validate-damage-oracle.mjs",
    "sync:type-chart": "node scripts/sync-type-chart.mjs",
    "api:migrate": "bun --env-file-if-exists=.env apps/api/src/migrate.js",
    "api:db:prepare": "node --env-file-if-exists=.env scripts/prepare-runtime-mysql-role.mjs",
    "api:start": "bun --env-file-if-exists=.env apps/api/src/server.js",
    "api:runtime:smoke": "bun apps/api/test/bun-runtime-smoke.mjs",
    "data:sync": "npm run sync --workspace @spinda-stop/data"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0"
  }
}
