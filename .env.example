APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8787
# Credenciais fictícias do PostgreSQL local; mantenha POSTGRES_PASSWORD e a URL de migração alinhadas.
POSTGRES_PASSWORD=spinda-local
# Conta de runtime: o comando api:db:prepare concede permissões de dados sem DDL.
DATABASE_URL=postgresql://spinda_app:spinda-app-local@127.0.0.1:5432/spinda_stop
# Conta administrativa usada somente para migrações e preparação local de papéis.
DATABASE_MIGRATION_URL=postgresql://spinda:spinda-local@127.0.0.1:5432/spinda_stop
# Configure estes campos apenas em uma aplicação OAuth de desenvolvimento.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
COOKIE_SECURE=false
FRIEND_CODE_ENCRYPTION_KEY=
# Segredo fictício apenas para testar /api/cron/cleanup em desenvolvimento.
CRON_SECRET=local-only-cron-secret
# Gere uma chave independente de 32 bytes para deployments Vercel; o valor local é ignorado.
RATE_LIMIT_HASH_SECRET=
