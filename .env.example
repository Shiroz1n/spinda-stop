# Modelo local: copie para .env. Nunca coloque credenciais reais neste arquivo versionado.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8787
# Caminho relativo à raiz do repositório; se omitido, usa .local/spinda-stop.sqlite.
SPINDA_DB_PATH=.local/spinda-stop.sqlite
# OAuth opcional para desenvolvimento; obtenha credenciais próprias no GitHub e mantenha o secret privado.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
COOKIE_SECURE=false
# Opcional. Gere 32 bytes aleatórios em hexadecimal; não reutilize uma chave real em arquivo versionado.
FRIEND_CODE_ENCRYPTION_KEY=
