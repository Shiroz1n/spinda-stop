APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8787
# Valores fictícios para o MySQL local; substitua por segredos privados nos ambientes remotos.
MYSQL_ROOT_PASSWORD=spinda-local-root
# Usuário de runtime sem DDL. api:db:prepare configura estes grants só no banco local.
DATABASE_URL=mysql://spinda_app:spinda-app-local@127.0.0.1:3306/spinda_stop
# Usuário administrativo usado apenas em migrações e preparação dos grants locais.
DATABASE_MIGRATION_URL=mysql://root:spinda-local-root@127.0.0.1:3306/spinda_stop
# Configure estes campos apenas em uma aplicação OAuth de desenvolvimento.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
COOKIE_SECURE=false
FRIEND_CODE_ENCRYPTION_KEY=
# Segredo fictício apenas para testar /api/cron/cleanup em desenvolvimento.
CRON_SECRET=local-only-cron-secret
# Gere uma chave independente de 32 bytes para deployments Vercel; o valor local é ignorado.
RATE_LIMIT_HASH_SECRET=
